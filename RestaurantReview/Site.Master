<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="RestaurantReview.Site" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Honest Plates</title>

    <!-- Bootstrap 5.3, Google Fonts, then our styles (ours last so they win) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&family=Noto+Sans:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="style/Home.css?v=4" />

    <!-- Pages add extra CSS here (e.g. RestaurantProfile adds Profile.css) -->
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Shared nav: one copy for the whole site -->
        <nav class="hp-nav">
            <a class="logo-wrap" href="Home.aspx">
                <div class="logo-text">
                    <span class="logo-en">Honest Plates</span>
                    <span class="logo-sub">Restaurant Reviews</span>
                </div>
            </a>
            <div class="nav-links d-flex align-items-center gap-3">
                <%-- Back to the course home page (index.html sits one folder above Project2 on cis-iis2) --%>
                <a href="../index.html" class="btn-hp btn-hp-outline btn-hp-back">&larr; All Projects</a>
                <a href="Home.aspx" class="nav-link-hp">Find a Restaurant</a>

                <%-- Logged out: Log In + Create Account (shown by default) --%>
                <asp:PlaceHolder ID="phLoggedOut" runat="server">
                    <a href="Login.aspx" class="nav-link-hp">Log In</a>
                    <a href="Register.aspx" class="btn-hp">Create Account</a>
                </asp:PlaceHolder>

                <%-- Logged in: Dashboard + greeting + Log Out (Site.master.cs turns this on) --%>
                <asp:PlaceHolder ID="phLoggedIn" runat="server" Visible="false">
                    <a href="Dashboard.aspx" class="nav-link-hp">Dashboard</a>
                    <asp:Label ID="lblGreeting" runat="server" CssClass="nav-greeting" />
                    <a href="Logout.aspx" class="btn-hp">Log Out</a>
                </asp:PlaceHolder>
            </div>
        </nav>

        <!-- Each page's own content goes here -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server">
        </asp:ContentPlaceHolder>

        <!-- Shared footer -->
        <footer class="hp-footer">
            <div>Honest Plates &mdash; Restaurant Reviews &middot; CIS-3342 &middot; Temple University &middot; Fall 2026</div>
            <div>Thimmy Le &mdash; tut54751</div>
        </footer>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>