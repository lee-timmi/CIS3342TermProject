@* Came from Murach's ASP.NET Core MVC, Chapter 16 Page 677 on the Account/Login view. *@
@model HonestPlates.Web.Models.LoginForm
@{
    ViewData["Title"] = "Log In";
}

<div class="container my-5" style="max-width: 480px;">
    @* Came from Murach's ASP.NET Core MVC, Chapter 3 Page 97 on working with images. *@
    <img src="~/images/hero.jpg" alt="Food at an Honest Plates restaurant" class="page-banner" />

    <h1 class="mb-3">Log In</h1>

    @* Messages from Register, Verify, or Forget Me.
       Came from Murach's ASP.NET Core MVC, Chapter 8 Page 307 on TempData. *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    @* Came from Murach's ASP.NET Core MVC, Chapter 2 Page 75 on forms with validation messages. *@
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* Unverified account: a link straight to the Verify page *@
        @if (ViewBag.VerifyUsername != null)
        {
            <p><a asp-action="Verify" asp-route-username="@ViewBag.VerifyUsername">Enter your verification code</a></p>
        }

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" type="password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-4">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">Remember my username on this computer</label>
        </div>

        <button type="submit" class="btn-hp">Log In</button>
    </form>

    @* Forget Me: only shown when this computer has a saved username.
       Came from Murach's ASP.NET Core MVC, Chapter 9 Page 349 on reading cookies. *@
    @if (Context.Request.Cookies["HP_Username"] != null)
    {
        <form asp-action="ForgetMe" method="post" class="mt-3">
            <button type="submit" class="btn-hp btn-hp-outline">Forget my username</button>
        </form>
    }

    <p class="mt-4">New here? <a asp-action="Register">Create an account</a></p>
    @* Forgot username / reset password links go here once those pages are built *@
</div>