@* Came from Murach's ASP.NET Core MVC, Chapter 2 Page 59 on strongly-typed views. *@
@model HonestPlates.Web.Models.RegisterForm
@{
    ViewData["Title"] = "Create Account";
    string[] questions = ViewBag.Questions;
}

<div class="container my-5" style="max-width: 640px;">
    <h1 class="mb-4">Create an Account</h1>

    @* Came from Murach's ASP.NET Core MVC, Chapter 2 Page 75 on checking validation and showing error messages. *@
    <form asp-action="Register" method="post">

        @* Came from Murach's ASP.NET Core MVC, Chapter 11 Page 409 on model-level validation messages. *@
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @* User type. Came from Murach's ASP.NET Core MVC, Chapter 2 Page 59 on the asp-for tag helper. *@
        <div class="mb-3">
            <label class="form-label d-block">I am a...</label>
            <div class="form-check form-check-inline">
                <input asp-for="UserType" type="radio" value="Reviewer" id="typeReviewer" class="form-check-input" />
                <label for="typeReviewer" class="form-check-label">Reviewer</label>
            </div>
            <div class="form-check form-check-inline">
                <input asp-for="UserType" type="radio" value="Representative" id="typeRep" class="form-check-input" />
                <label for="typeRep" class="form-check-label">Restaurant Representative</label>
            </div>
            @* Came from Murach's ASP.NET Core MVC, Chapter 11 Page 409 on property-level validation messages. *@
            <span asp-validation-for="UserType" class="text-danger d-block"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="FirstName" class="form-label">First name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="LastName" class="form-label">Last name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Phone" class="form-label">Phone (optional)</label>
            <input asp-for="Phone" class="form-control" placeholder="e.g. 215-555-0123" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        @* Came from Murach's ASP.NET Core MVC, Chapter 11 Page 403 on a registration page with validation. *@
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        @* Security questions. Came from Murach's ASP.NET Core MVC, Chapter 7 Page 257 on binding a list to a <select>. *@
        <h2 class="h5 mt-4">Security questions</h2>
        <p class="text-muted small">Pick 3 different questions. One is asked at random if you forget your username or password.</p>

        <div class="mb-3">
            <select asp-for="Question1" class="form-select">
                <option value="">-- Pick question 1 --</option>
                @foreach (string q in questions)
                {
                    <option value="@q">@q</option>
                }
            </select>
            <span asp-validation-for="Question1" class="text-danger d-block"></span>
            <input asp-for="Answer1" class="form-control mt-2" placeholder="Your answer" />
            <span asp-validation-for="Answer1" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <select asp-for="Question2" class="form-select">
                <option value="">-- Pick question 2 --</option>
                @foreach (string q in questions)
                {
                    <option value="@q">@q</option>
                }
            </select>
            <span asp-validation-for="Question2" class="text-danger d-block"></span>
            <input asp-for="Answer2" class="form-control mt-2" placeholder="Your answer" />
            <span asp-validation-for="Answer2" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <select asp-for="Question3" class="form-select">
                <option value="">-- Pick question 3 --</option>
                @foreach (string q in questions)
                {
                    <option value="@q">@q</option>
                }
            </select>
            <span asp-validation-for="Question3" class="text-danger d-block"></span>
            <input asp-for="Answer3" class="form-control mt-2" placeholder="Your answer" />
            <span asp-validation-for="Answer3" class="text-danger"></span>
        </div>

        @* Came from Murach's ASP.NET Core MVC, Chapter 16 Page 677 on a "remember me" checkbox. *@
        <div class="form-check mb-4">
            <input asp-for="RememberUsername" class="form-check-input" />
            <label asp-for="RememberUsername" class="form-check-label">Remember my username on this computer</label>
        </div>

        <button type="submit" class="btn-hp">Create Account</button>
    </form>

    <p class="mt-3">Already have an account? <a asp-action="Login">Log in</a></p>
</div>