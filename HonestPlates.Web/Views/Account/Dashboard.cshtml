@using System.Data
@using HonestPlates.Data.Models
@{
    ViewData["Title"] = "Dashboard";
    string userType = ViewBag.UserType;
    DataTable myReviews = ViewBag.MyReviews;
    DataTable myRestaurants = ViewBag.MyRestaurants;
}

@* The review cards reuse the profile page's review styles.
   Came from Murach's ASP.NET Core MVC, Chapter 15 Page 629 on sections in a layout. *@
@section Styles {
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />
}

<div class="container my-5" style="max-width: 900px;">
    @* Came from Murach's ASP.NET Core MVC, Chapter 3 Page 97 on working with images. *@
    <img src="~/images/hero.jpg" alt="Food at an Honest Plates restaurant" class="page-banner" />

    <h1 class="mb-1">Welcome back, @ViewBag.FirstName!</h1>
    <p class="text-muted mb-4">You're logged in as a @(userType == "Representative" ? "Restaurant Representative" : "Reviewer"). Here's what you can do.</p>
    
    @* A message from a page that sent the user back here (for example, a Reviewer opening a rep-only page).
       Came from Murach's ASP.NET Core MVC, Chapter 8 Page 306 on using TempData. *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-warning">@TempData["Message"]</div>
    }

    @if (userType == "Representative")
    {
        @* My restaurant: each restaurant this rep manages, with counts of what needs attention.*@
        <h2 class="section-heading">My restaurant</h2>

        @* Came from Murach's ASP.NET Core MVC, Chapter 7 Page 230 on inline loops and conditional statements. *@
        @if (ViewBag.RestaurantError != null)
        {
            <p class="text-danger">@ViewBag.RestaurantError</p>
        }
        else if (myRestaurants == null || myRestaurants.Rows.Count == 0)
        {
            <p class="no-reviews-msg">
                You haven't added your restaurant yet.
                <a asp-controller="Restaurant" asp-action="Manage">Add your restaurant</a> to start getting reviews.
            </p>
        }
        else
        {
            foreach (DataRow restaurant in myRestaurants.Rows)
            {
                @* Came from Murach's ASP.NET Core MVC, Chapter 3 Page 113 on Bootstrap cards. *@
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-1">@restaurant["RestaurantName"]</h5>
                        <p class="text-muted mb-3">@restaurant["RestaurantCuisine"] · @restaurant["RestaurantCity"], @restaurant["RestaurantState"]</p>

                        <div class="review-ratings mb-3">
                            <span class="rating-pill">Reviews <strong>@restaurant["ReviewCount"]</strong></span>
                            <span class="rating-pill">Need a response <strong>@restaurant["NeedsResponse"]</strong></span>
                            <span class="rating-pill">Pending reservations <strong>@restaurant["PendingReservations"]</strong></span>
                        </div>
                        
                        <a asp-controller="Restaurant" asp-action="Profile" asp-route-id="@restaurant["RestaurantID"]" class="btn-hp">View profile</a>
                    
                    </div>
                </div>
            }
        }

        @* Representative tools. The buttons turn into links when each page is built.
           Came from Murach's ASP.NET Core MVC, Chapter 3 Page 113 on Bootstrap cards. *@
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Manage My Restaurant</h5>
                        <p class="card-text text-muted">Add or edit your restaurant's details, hours, and photos.</p>
                        <a asp-controller="Restaurant" asp-action="Manage" class="btn-hp">Manage Restaurant</a>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Reservations</h5>
                        <p class="card-text text-muted">View, confirm, change, or cancel reservations.</p>
                        <button type="button" class="btn-hp btn-hp-outline" disabled>Coming soon</button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">Respond to Reviews</h5>
                        <p class="card-text text-muted">Read your restaurant's reviews and post responses.</p>
                        <button type="button" class="btn-hp btn-hp-outline" disabled>Coming soon</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Tools for everyone. Came from Murach's ASP.NET Core MVC, Chapter 3 Page 113 on Bootstrap cards. *@
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Find a Restaurant</h5>
                    <p class="card-text text-muted">Search by cuisine and location, then read reviews or write your own.</p>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="search" class="btn-hp">Search</a>
                </div>
            </div>
        </div>
    </div>

    @* My reviews: every review this user wrote, newest first (with Edit and Delete).
       Came from Project 2: GetReviewsByUser. *@
    <h2 class="section-heading">My reviews</h2>

    @if (ViewBag.ReviewsError != null)
    {
        <p class="text-danger">@ViewBag.ReviewsError</p>
    }
    else if (myReviews == null || myReviews.Rows.Count == 0)
    {
        <p class="no-reviews-msg">You haven't written any reviews yet. Find a restaurant to get started.</p>
    }
    else
    {
        foreach (DataRow review in myReviews.Rows)
        {
            <div class="review-card">
                <div class="review-header">
                    <a class="review-author" asp-controller="Restaurant" asp-action="Profile" asp-route-id="@review["RestaurantID"]">@review["RestaurantName"]</a>
                    <span class="review-date">@Convert.ToDateTime(review["ReviewDate"]).ToString("MMMM d, yyyy")</span>
                </div>

                <p class="review-text">@review["ReviewText"]</p>

                <div class="review-ratings">
                    <span class="rating-pill">Food <strong>@review["FoodRating"]</strong></span>
                    <span class="rating-pill">Service <strong>@review["ServiceRating"]</strong></span>
                    @if (review["AtmosphereRating"] != DBNull.Value)
                    {
                        <span class="rating-pill">Atmosphere <strong>@review["AtmosphereRating"]</strong></span>
                    }
                    <span class="rating-pill">Price <strong>@Rating.Dollars(Convert.ToInt32(review["PriceRating"]))</strong></span>
                </div>

                @if (review["ResponseText"] != DBNull.Value)
                {
                    <div class="review-response">
                        <span class="review-response-label">Response from the restaurant</span>
                        @review["ResponseText"]
                    </div>
                }

                @* Edit is a link (GET). Delete is a small POST form, so a link can't delete anything.*@
                <div class="review-actions mt-3">
                    <a asp-controller="Review" asp-action="Edit" asp-route-id="@review["ReviewID"]" class="btn-hp btn-hp-outline">Edit</a>
                    <form asp-controller="Review" asp-action="Delete" asp-route-id="@review["ReviewID"]" method="post"
                          onsubmit="return confirm('Delete your review of @review["RestaurantName"]? This can\'t be undone.');">
                        <button type="submit" class="btn-hp btn-hp-outline">Delete</button>
                    </form>
                </div>
            </div>
        }
    }
</div>