@using System.Data
@using HonestPlates.Data.Models

@model HonestPlates.Data.Models.Restaurant
@{
    ViewData["Title"] = Model != null ? Model.Name : "Restaurant";
    DataTable hours = ViewBag.Hours;
    int today = (int)DateTime.Now.DayOfWeek;   // 0 = Sunday, same numbering as the table
    int profilePhotoID = ViewBag.ProfilePhotoID == null ? 0 : ViewBag.ProfilePhotoID;
    int logoID = ViewBag.LogoID == null ? 0 : ViewBag.LogoID;
    string bannerUrl = profilePhotoID > 0 ? Url.Content("~/Restaurant/Photo/" + profilePhotoID) : Url.Content("~/images/hero.jpg");

    DataTable? photos = ViewBag.Photos;
    DataTable? reviews = ViewBag.Reviews;
    Rating? rating = ViewBag.Rating;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />
}

@if (ViewBag.Error != null)
{
    <div class="text-center mt-5">
        <p class="text-danger">@ViewBag.Error</p>
        <a asp-controller="Home" asp-action="Index" class="btn-hp">Back to search</a>
    </div>
}
else
{
    <div class="profile-hero">
        <img src="@bannerUrl" alt="@Model.Name" class="profile-hero-img" />
        <div class="profile-hero-overlay">
            @if (logoID > 0)
            {
                <img class="profile-logo" src="@Url.Content("~/Restaurant/Photo/" + logoID)" alt="@Model.Name logo" />
            }
            <span class="profile-cuisine-tag">@Model.Cuisine</span>
            <h1 class="profile-name">@Model.Name</h1>
        </div>
    </div>

    <div class="profile-body">
        <div class="profile-info-grid">
            <div class="profile-about">
                <h2 class="section-heading">About</h2>
                <p class="profile-description">@Model.Description</p>
            </div>

            <aside class="profile-details">
                <div class="detail-item">
                    <span class="detail-label">Address</span>
                    <span class="detail-value">@Model.Street, @Model.City, @Model.State @Model.Zip</span>
                </div>

                @if (Model.Phone != "")
                {
                    <div class="detail-item">
                        <span class="detail-label">Phone</span>
                        <span class="detail-value">@Model.Phone</span>
                    </div>
                }

                <div class="detail-item">
                    <span class="detail-label">Hours</span>
                    @if (hours.Rows.Count == 0)
                    {
                        <span class="detail-value">Hours not listed</span>
                    }
                    else
                    {
                        <table class="hours-table">
                            @foreach (DataRow row in hours.Rows)
                            {
                                int day = Convert.ToInt32(row["DayOfWeek"]);
                                <tr class="@(day == today ? "hours-today" : null)">
                                    <td>@((DayOfWeek)day)</td>
                                    <td>@Model.FormatHours(row)</td>
                                </tr>
                            }
                        </table>
                    }
                </div>

                @if (Model.Owner != "")
                {
                    <div class="detail-item">
                        <span class="detail-label">Owner</span>
                        <span class="detail-value">@Model.Owner</span>
                    </div>
                }

                @if (Model.Website.StartsWith("http://") || Model.Website.StartsWith("https://"))
                {
                    <div class="detail-item">
                        <span class="detail-label">Website</span>
                        <a class="detail-value" href="@Model.Website" target="_blank">Visit website</a>
                    </div>
                }

                @if (Model.SocialMedia.StartsWith("http://") || Model.SocialMedia.StartsWith("https://"))
                {
                    <div class="detail-item">
                        <span class="detail-label">Social Media</span>
                        <a class="detail-value" href="@Model.SocialMedia" target="_blank">Follow us</a>
                    </div>
                }
            </aside>
        </div>

        @* Photo gallery: every photo except the logo, with its caption. Only on the profile, as the spec requires.
   Came from Project 2 (ASP.NET 4.6 book, scanned, no page): ShowPhotos + ImageGrab.aspx. *@
<hr class="profile-divider" />
<h2 class="section-heading">Photos</h2>
@{ bool anyPhotos = false; }
<div class="gallery-grid">
    @if (photos != null)
    {
        foreach (DataRow photo in photos.Rows)
        {
            if (photo["ImageCategory"].ToString() != "Logo")
            {
                anyPhotos = true;
                <figure class="gallery-item">
                    <img src="@Url.Content("~/Restaurant/Photo/" + photo["ImageID"])" alt="@photo["Caption"]" />
                    <figcaption>@photo["Caption"]</figcaption>
                </figure>
            }
        }
    }
</div>
@if (!anyPhotos)
{
    <p class="no-reviews-msg">No photos yet.</p>
}

@* Reviews: the rating summary, then every review (newest first) with its ratings, photo, and the rep's response.
   Came from Project 2 (ASP.NET 4.6 book, scanned, no page): pnlRatingSummary + the rptReviews Repeater. *@
<hr class="profile-divider" />
<h2 class="section-heading">Reviews</h2>

@if (ViewBag.ReviewsError != null)
{
    <p class="text-danger">@ViewBag.ReviewsError</p>
}
else if (rating == null || !rating.HasReviews())
{
    <p class="no-reviews-msg">No reviews yet.</p>
}
else
{
    <div class="rating-summary">
        <div class="avg-row">
            <div class="avg-item"><span class="avg-label">Overall</span><span class="avg-value">@rating.Format(rating.Overall, true)</span><span class="avg-max">/5</span></div>
            <div class="avg-item"><span class="avg-label">Food</span><span class="avg-value">@rating.Format(rating.Food, true)</span><span class="avg-max">/5</span></div>
            <div class="avg-item"><span class="avg-label">Service</span><span class="avg-value">@rating.Format(rating.Service, true)</span><span class="avg-max">/5</span></div>
            <div class="avg-item"><span class="avg-label">Atmosphere</span><span class="avg-value">@rating.Format(rating.Atmosphere, rating.HasAtmosphere)</span><span class="avg-max">/5</span></div>
            <div class="avg-item"><span class="avg-label">Price</span><span class="avg-value">@rating.PriceSigns()</span></div>
        </div>
        <p class="avg-count">Based on @rating.ReviewCount review(s)</p>
    </div>

    foreach (DataRow review in reviews.Rows)
    {
        <div class="review-card">
            <div class="review-header">
                <span class="review-author">@Review.ReviewerName(review)</span>
                <span class="review-date">@Convert.ToDateTime(review["ReviewDate"]).ToString("MMMM d, yyyy")</span>
            </div>

            @if (review["VisitDateTime"] != DBNull.Value)
            {
                <div class="review-visit">Visited @Convert.ToDateTime(review["VisitDateTime"]).ToString("MMMM d, yyyy 'at' h:mm tt")</div>
            }

            <p class="review-text">@review["ReviewText"]</p>

            @if (review["HasPhoto"].ToString() == "1")
            {
                <img class="review-photo" src="@Url.Content("~/Restaurant/ReviewPhoto/" + review["ReviewID"])" alt="Photo from this review" />
            }

            <div class="review-ratings">
                <span class="rating-pill">Food <strong>@review["FoodRating"]</strong></span>
                <span class="rating-pill">Service <strong>@review["ServiceRating"]</strong></span>
                @if (review["AtmosphereRating"] != DBNull.Value)
                {
                    <span class="rating-pill">Atmosphere <strong>@review["AtmosphereRating"]</strong></span>
                }
                <span class="rating-pill">Price <strong>@Rating.Dollars(Convert.ToInt32(review["PriceRating"]))</strong></span>
            </div>

            @if (review["ResponseText"] != DBNull.Value)
            {
                <div class="review-response">
                    <span class="review-response-label">Response from the restaurant</span>
                    @review["ResponseText"]
                </div>
            }
        </div>
    }
}




    </div>
}