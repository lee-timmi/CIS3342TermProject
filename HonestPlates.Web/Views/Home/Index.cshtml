@using System.Data
@using HonestPlates.Data.Models

@{
    ViewData["Title"] = "Honest Plates - HOME";

    List<string> cuisines = ViewBag.Cuisines;
    DataTable locations = ViewBag.Locations;

    List<string> selectedCuisines = ViewBag.SelectedCuisines ?? new List<string>();
    string selectedLocation = ViewBag.SelectedLocation ?? "";

    // Each state once (in order), with its restaurant count, for the dropdown headings
    List<string> states = new List<string>();
    List<string> stateCounts = new List<string>();
    foreach (DataRow row in locations.Rows)
    {
        string state = row["RestaurantState"].ToString();
        if (!states.Contains(state))
        {
            states.Add(state);
            stateCounts.Add(row["StateCount"].ToString());
        }
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/Home.css" asp-append-version="true" />
}

<section id="search" class="hero hero-photo">
    <p class="hero-eyebrow">Find the best</p>
    <h1 class="hero-headline">Restaurants <span>near you</span></h1>
    <p class="hero-sub">Honest ratings for food, service and atmosphere, from people who ate there.</p>

    <form method="get" asp-action="Search" class="search-box">
        <div class="cuisine-pills">
            @for (int i = 0; i < cuisines.Count; i++)
            {
                <input type="checkbox" id="cuisine@(i)" name="cuisines" value="@cuisines[i]"
                       checked="@selectedCuisines.Contains(cuisines[i])" />
                <label for="cuisine@(i)">@cuisines[i]</label>
            }
        </div>

        <div class="search-row">
            <select name="location" class="search-input">
            <option value="">Any location</option>
            @for (int s = 0; s < states.Count; s++)
            {
                string allValue = "|" + states[s];
                <optgroup label="@states[s]">
                    <option value="@allValue" selected="@(allValue == selectedLocation)">All of @states[s] (@stateCounts[s])</option>
                    @foreach (DataRow row in locations.Rows)
                    {
                        if (row["RestaurantState"].ToString() == states[s])
                        {
                            string value = row["RestaurantCity"] + "|" + states[s];
                            <option value="@value" selected="@(value == selectedLocation)">@row["RestaurantCity"], @states[s] (@row["CityCount"])</option>
                        }
                    }
                </optgroup>
            }
            </select>

            <button type="submit" class="btn-hp">Search</button>
            <a asp-action="Index" class="btn-hp btn-hp-outline">Clear</a>
        </div>
        <p class="search-hint">Pick one or more cuisines, a city, a state, or any mix. Clear starts over.</p>

        @if (ViewBag.Error != null)
        {
            <p class="search-error">@ViewBag.Error</p>
        }
    </form>
</section>

@* Search results as cards: name, cuisine, short description, overall rating, address.
   Came from Project 2 (ASP.NET 4.6 book, scanned, no page): the rptResults card Repeater, rebuilt with a Razor foreach.
   Came from Murach's ASP.NET Core MVC, Chapter 7 Page 247 on tag helpers for links (asp-route-id). *@

@if (ViewBag.Results != null)
{
    List<Restaurant> results = ViewBag.Results;
    <section class="results-section">
        
        <div class="results-header">
            <p class="results-count">@results.Count restaurant@(results.Count == 1 ? "" : "s") found</p>

            @* Save this search (serialization): logged-in users only.
            Hidden fields send the same cuisines + location back. *@
            @if (ViewBag.History != null)
            {
                <form method="post" asp-action="SaveSearch" class="save-search-form">
                    @foreach (string cuisine in selectedCuisines)
                    {
                        <input type="hidden" name="cuisines" value="@cuisine" />
                    }
                    <input type="hidden" name="location" value="@selectedLocation" />
                    <button type="submit" class="btn-hp btn-hp-outline">☆ Save this search</button>
                </form>
            }
            @if (TempData["SaveSearchMessage"] != null)
            {
                <p class="history-message">@TempData["SaveSearchMessage"]</p>
            }
        </div>

        <div class="results-grid">
            @foreach (Restaurant restaurant in results)
            {
                <partial name="_RestaurantCard" model="restaurant" />
            }
        </div>
    </section>
}

@* Saved searches + recently viewed (serialization), for logged-in users. *@
@if (ViewBag.History != null)
{
    UserHistory history = ViewBag.History;
    if (history.SavedSearches.Count > 0 || history.RecentlyViewed.Count > 0 || TempData["HistoryMessage"] != null)
    {
         <section class="results-section history-section">
            <div class="section-heading">
                <p class="section-eyebrow">Pick up where you left off</p>
                <h2 class="section-title">Your searches and restaurants</h2>
            </div>

            @if (TempData["HistoryMessage"] != null)
            {
                <p class="history-message">@TempData["HistoryMessage"]</p>
            }

            @if (history.SavedSearches.Count > 0)
            {
                <h3 class="history-heading">Saved searches</h3>
                <div class="history-links">
                    @for (int i = 0; i < history.SavedSearches.Count; i++)
                    {
                        SavedSearch saved = history.SavedSearches[i];
                        <span class="history-pill">
                            <a href="@(Url.Action("Search") + saved.QueryString())">@saved.Description()</a>
                            <form method="post" asp-action="RemoveSearch" class="remove-search-form">
                                <input type="hidden" name="index" value="@i" />
                                <button type="submit" class="remove-search" title="Remove this saved search">✕</button>
                            </form>
                        </span>
                    }
                </div>
            }

            @if (history.RecentlyViewed.Count > 0)
            {
                <h3 class="history-heading">Recently viewed</h3>
                <div class="history-links">
                    @foreach (RecentView view in history.RecentlyViewed)
                    {
                        <a class="history-pill" asp-controller="Restaurant" asp-action="Profile" asp-route-id="@view.RestaurantID">@view.Name</a>
                    }
                </div>
            }
         </section>
    }
}

@if (ViewBag.TopRated != null)
{
    List<Restaurant> topRated = ViewBag.TopRated;
    if (topRated.Count > 0)
    {
        <section class="results-section">
            <div class="section-heading">
                <p class="section-eyebrow">Diners' favorites</p>
                <h2 class="section-title">Top rated in Philadelphia</h2>
            </div>
            <div class="results-grid">
                @foreach (Restaurant restaurant in topRated)
                {
                    <partial name="_RestaurantCard" model="restaurant" />
                }
            </div>
        </section>
    }
}

@* How it works: one card per kind of user. The "create an account" buttons hide once someone is logged in.
   Came from Project 2 (ASP.NET 4.6 book, scanned, no page): the how-it-works section.
   Came from Murach's ASP.NET Core MVC, Chapter 9 Page 327 on using session state in views. *@
<section class="how-it-works">
    <div class="section-heading">
        <p class="section-eyebrow">How it works</p>
        <h2 class="section-title">Something for everyone at the table</h2>
    </div>
    <div class="how-grid">
        <div class="how-card">
            <span class="how-step">1</span>
            <h3>Diners</h3>
            <p>Search by cuisine and location, read honest reviews, and request a table. No account needed.</p>
            <a href="#search" class="btn-hp btn-hp-outline">Find a restaurant</a>
        </div>
        <div class="how-card">
            <span class="how-step">2</span>
            <h3>Reviewers</h3>
            <p>Rate the food, service, atmosphere and price, add a photo, and edit your reviews any time.</p>
            @if (Context.Session.GetInt32("UserID") == null)
            {
                <a asp-controller="Account" asp-action="Register" class="btn-hp btn-hp-outline">Create an account</a>
            }
        </div>
        <div class="how-card">
            <span class="how-step">3</span>
            <h3>Restaurant owners</h3>
            <p>Add your restaurant's profile, hours and photos, manage reservations, and answer reviews.</p>
            @if (Context.Session.GetInt32("UserID") == null)
            {
                <a asp-controller="Account" asp-action="Register" class="btn-hp btn-hp-outline">Add your restaurant</a>
            }
        </div>
    </div>
</section>

