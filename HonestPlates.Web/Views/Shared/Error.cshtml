@* Shown when something unexpected breaks on the live site (Program.cs sends errors here).
   Came from Murach's ASP.NET Core MVC, Chapter 3 Page 97 on working with images. *@
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container my-5 text-center" style="max-width: 640px;">
    <img src="~/images/hero.jpg" alt="Food at an Honest Plates restaurant" class="page-banner" />
    <h1 class="mb-3">Something went wrong</h1>
    <p>Sorry, we couldn't load that page. Please try again in a moment.</p>
    <a asp-controller="Home" asp-action="Index" class="btn-hp">Back to the home page</a>
</div>