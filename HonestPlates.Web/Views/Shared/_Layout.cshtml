<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HonestPlates</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&family=Noto+Sans:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HonestPlates.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="hp-nav">
            <a class="logo-wrap" asp-controller="Home" asp-action="Index">
                <div class="logo-text">
                    <span class="logo-en">Honest Plates</span>
                    <span class="logo-sub">Restaurant Reviews</span>
                </div>
            </a>
            <div class="nav-links d-flex align-items-center gap-3">
                <a href="../index.html" class="btn-hp btn-hp-outline btn-hp-back">&larr; All Projects</a>
                <a asp-controller="Home" asp-action="Index" class="nav-link-hp">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="search" class="nav-link-hp">Search</a>
                <a asp-controller="Account" asp-action="Login" class="nav-link-hp">Log In</a>
                <a asp-controller="Account" asp-action="Register" class="btn-hp">Register</a>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="hp-footer">
        <div>Honest Plates &mdash; Restaurant Reviews &middot; CIS-3342 &middot; Temple University &middot; Fall 2026</div>
        <div>Thimmy Le &middot; Tri Le</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
