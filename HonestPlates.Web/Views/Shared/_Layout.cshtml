@* Who is logged in (Tri's Login saves these three; empty when nobody is logged in).
   Came from Murach's ASP.NET Core MVC, Chapter 9 Page 327 on using session state in views. *@
@{
    int? userID = Context.Session.GetInt32("UserID");
    string? firstName = Context.Session.GetString("FirstName");
    string? userType = Context.Session.GetString("UserType");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HonestPlates</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700&family=Noto+Sans:wght@300;400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/HonestPlates.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="hp-nav">
            <a class="logo-wrap" asp-controller="Home" asp-action="Index">
                <div class="logo-text">
                    <span class="logo-en">Honest Plates</span>
                    <span class="logo-sub">Restaurant Reviews</span>
                </div>
            </a>
            <div class="nav-links d-flex align-items-center gap-3">
                <a href="../index.html" class="btn-hp btn-hp-outline btn-hp-back">&larr; All Projects</a>
                <a asp-controller="Home" asp-action="Index" class="nav-link-hp">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="search" class="nav-link-hp">Search</a>

                @* Logged out: Log In + Register. Logged in: greeting by user type + Log Out.
                   Came from Murach's ASP.NET Core MVC, Chapter 9 Page 327 on using session state in views. *@
                @if (userID == null)
                {
                    <a asp-controller="Account" asp-action="Login" class="nav-link-hp">Log In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-hp">Register</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Dashboard" class="nav-link-hp">Dashboard</a>

                    if (userType == "Representative")
                    {
                        @* Rep links go here once built: Dashboard, My Restaurant, Reservations *@
                        <span class="nav-greeting">Hi, @firstName (Restaurant Rep)</span>
                    }
                    else
                    {
                        @* Reviewer links go here once built: Dashboard, My Reviews *@
                        <span class="nav-greeting">Hi, @firstName (Reviewer)</span>
                    }
                    <a asp-controller="Account" asp-action="Logout" class="btn-hp">Log Out</a>
                }
            </div>
        </nav>
    </header>
        
    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="hp-footer">
        <div>Honest Plates &mdash; Restaurant Reviews &middot; CIS-3342 &middot; Temple University &middot; Fall 2026</div>
        <div>Thimmy Le &middot; Tri Le</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
