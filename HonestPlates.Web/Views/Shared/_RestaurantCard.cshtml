@using HonestPlates.Data.Models
@model Restaurant

@{
    // A short description: the first 120 characters, cut with "..."
    string description = Model.Description;
    if (description.Length > 120)
    {
        description = description.Substring(0, 117) + "...";
    }
}

<a class="restaurant-card" asp-controller="Restaurant" asp-action="Profile" asp-route-id="@Model.RestaurantID">

    @if (Model.LogoImageID > 0)
    {
        <div class="card-img-wrap">
            <img src="@Url.Content("~/Restaurant/Photo/" + Model.LogoImageID)" alt="@Model.Name logo" />
        </div>
    }

    <div class="card-body">
        <h3 class="card-name">@Model.Name</h3>
        <p class="card-cuisine">@Model.Cuisine</p>
        <p class="card-rating">@Model.RatingText</p>
        <p class="card-description">@description</p>
        <p class="card-location">@Model.Street, @Model.City, @Model.State @Model.Zip</p>
    </div>
</a>